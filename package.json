  "version": "0.0.1",
  "description": "AI pen handwriting converter — monorepo root",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
